[Unit]
Description=Load offline Docker images of the rover (first boot only)
After=docker.service
Requires=docker.service
Before=rover.service
ConditionPathExistsGlob=/opt/rover/images/*.tar.zst

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
ExecStart=/opt/rover/load-images.sh

[Install]
WantedBy=multi-user.target
