<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration to bring up the whole rover</description>
  <maintainer email="mstepanov2610@gmail.com">MaxX-Akela</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_fcu_bridge</exec_depend>
  <exec_depend>rover_arm</exec_depend>
  <exec_depend>rover_navigation</exec_depend>
  <exec_depend>rover_slam</exec_depend>
  <exec_depend>rover_vision</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
